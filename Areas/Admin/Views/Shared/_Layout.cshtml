<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebShopping</title>
    <script type="importmap"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html5shiv/3.7.3/html5shiv.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/respond.js/1.4.2/respond.min.js"></script>
    <link rel="stylesheet" href="~/css_admin/bootstrap-social.css" />
    <link rel="stylesheet" href="~/css_admin/bootstrap-theme.min.css"/>
    <link rel="stylesheet" href="~/css_admin/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css_admin/font-awesome.min.css"/>
    <link rel="stylesheet" href="~/css_admin/metisMenu.min.css"/>
    <link rel="stylesheet" href="~/css_admin/morris.css"/>
    <link rel="stylesheet" href="~/css_admin/startmin.css"/>
    <link rel="stylesheet" href="~/css_admin/timeline.css"/>

    <link rel="stylesheet" href="~/WebShopping.styles.css" asp-append-version="true" />
</head>
<body>
    <partial name="_Navigation"/>
    <partial name="_sidebar"/>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
   
    <script src="~/js_admin/bootstrap.min.js"></script>
    
    <script src="~/js_admin/flot-data.js"></script>
    <script src="~/js_admin/jquery.min.js"></script>
    <script src="~/js_admin/metisMenu.min.js"></script>
    <script src="~/js_admin/morris-data.js"></script>
    <script src="~/js_admin/morris.min.js"></script>
    <script src="~/js_admin/raphael.min.js"></script>
    <script src="~/js_admin/startmin.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
